{
  "variable": "df",
  "setup": "import numpy as np, pandas as pd\nrng = np.random.default_rng(42)\nn = 3000\nk = rng.integers(0, 4, n)\ncenters = rng.normal(0, 6, (4, 20))\ndf = pd.DataFrame(centers[k] + rng.normal(0, 1, (n, 20)), columns=[f'x{i}' for i in range(20)])\ndf['cluster'] = [f'grp_{v}' for v in k]\n",
  "settings": {
    "pcaEnabled": false,
    "maxAnchorsCpu": 5000
  },
  "steps": [
    {
      "name": "wait for ready",
      "until": "a.phase === 'ready'",
      "timeout": 60000
    },
    {
      "name": "color by cluster",
      "eval": "const col = a.describe.columns.find(c => c.name === 'cluster'); a.setColorColumn(col.index)",
      "until": "a.colorMeta && a.colorMeta.kind === 'categorical' && a.colorMeta.categories.length === 4",
      "timeout": 15000,
      "assert": [
        "a.colorMeta.categories.length === 4",
        "a.renderVisibleCount === a.nAnchors"
      ]
    },
    {
      "name": "hide first category",
      "eval": "a.toggleCategory(0, false)",
      "until": "a.anyHidden",
      "timeout": 3000,
      "screenshot": "legend-hide-cat0.png",
      "assert": [
        "a.isCategoryHidden(0)",
        "!a.isCategoryHidden(1)",
        "a.hiddenCategories.size > 0",
        "a.renderVisibleCount > 0",
        "a.renderVisibleCount < a.nAnchors"
      ],
      "report": "{ hidden: [...(a.hiddenCategories.get(a.colorColumn) || [])], anyHidden: a.anyHidden, visibleCount: a.renderVisibleCount, totalCount: a.nAnchors }"
    },
    {
      "name": "hidden point is not hoverable",
      "eval": "const xy = a['anchorXY']; let found = false; for (let i = 0; i < a.nAnchors * 2; i += 2) { const v = a.colorValues[a.anchorPos ? a.anchorPos[i/2] : i/2]; if (v === 0) { a['onPointer']({ x: 400, y: 300, world: [xy[i], xy[i+1]] }); found = true; break; } } window.__tried = found",
      "until": "window.__tried !== undefined",
      "timeout": 3000,
      "report": "{ tooltip: a.tooltip ? a.tooltip.row : null }"
    },
    {
      "name": "hide second category too",
      "eval": "a.toggleCategory(1, false)",
      "until": "a.isCategoryHidden(1)",
      "timeout": 3000,
      "assert": [
        "a.isCategoryHidden(0)",
        "a.isCategoryHidden(1)",
        "!a.isCategoryHidden(2)",
        "a.renderVisibleCount > 0",
        "a.renderVisibleCount < a.nAnchors"
      ]
    },
    {
      "name": "alt-click to solo category 2 (hides 0,1,3)",
      "eval": "a.toggleCategory(2, true)",
      "until": "!a.isCategoryHidden(2) && a.isCategoryHidden(0) && a.isCategoryHidden(3)",
      "timeout": 3000,
      "screenshot": "legend-solo-cat2.png",
      "assert": [
        "!a.isCategoryHidden(2)",
        "a.isCategoryHidden(0)",
        "a.isCategoryHidden(1)",
        "a.isCategoryHidden(3)",
        "a.renderVisibleCount > 0",
        "a.renderVisibleCount < a.nAnchors"
      ],
      "report": "{ hidden: [...(a.hiddenCategories.get(a.colorColumn) || [])], visibleCount: a.renderVisibleCount, totalCount: a.nAnchors }"
    },
    {
      "name": "alt-click again to show all (toggle off solo)",
      "eval": "a.toggleCategory(2, true)",
      "until": "!a.anyHidden",
      "timeout": 3000,
      "assert": [
        "!a.anyHidden",
        "a.hiddenCategories.size === 0",
        "a.renderVisibleCount === a.nAnchors"
      ]
    },
    {
      "name": "showAllCategories after hiding some",
      "eval": "a.toggleCategory(0, false); a.toggleCategory(1, false); a.showAllCategories()",
      "until": "!a.anyHidden",
      "timeout": 3000,
      "assert": [
        "!a.anyHidden",
        "a.renderVisibleCount === a.nAnchors"
      ]
    },
    {
      "name": "hidden categories persisted in state",
      "eval": "a.toggleCategory(0, false); a.persist()",
      "until": "h.state && h.state.hiddenCategories",
      "timeout": 5000,
      "assert": [
        "h.state.hiddenCategories !== undefined"
      ],
      "report": "h.state.hiddenCategories"
    }
  ]
}
