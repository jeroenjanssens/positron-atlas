{
  "variable": "df",
  "setup": "import numpy as np, pandas as pd\nrng = np.random.default_rng(0)\nk = rng.integers(0, 6, 20000)\ncenters = rng.normal(0, 6, (6, 30))\ndf = pd.DataFrame(centers[k] + rng.normal(0, 1, (20000, 30)), columns=[f'x{i}' for i in range(30)])\ndf['cluster'] = [f'c{v}' for v in k]\ndf['score'] = df['x0'] * 2 + rng.normal(0, 1, 20000)\n",
  "settings": {
    "maxAnchorsCpu": 5000
  },
  "screenshot": "ui-map.png",
  "steps": [
    {
      "name": "map tab is default",
      "assert": [
        "a.ui.tab === 'map'",
        "(() => { const e = document.querySelector('[data-section=data]'); return !!e && e.offsetParent !== null; })()",
        "(() => { const e = document.querySelector('[data-section=umap]'); return !!e && e.offsetParent !== null; })()",
        "(() => { const e = document.querySelector('[data-section=result]'); return !!e && e.offsetParent !== null; })()",
        "!(() => { const e = document.querySelector('[data-section=color]'); return !!e && e.offsetParent !== null; })()",
        "document.querySelector('#tab-map').getAttribute('aria-selected') === 'true'",
        "[...document.querySelectorAll('.controls .tab')].map(t => t.textContent.trim()).join(',') === 'Map,Explore,Annotate,Export'",
        "document.querySelector('.controls .buttons button').textContent.includes('Restart')"
      ]
    },
    {
      "name": "explore tab",
      "click": "#tab-explore",
      "until": "a.ui.tab === 'explore'",
      "assert": [
        "(() => { const e = document.querySelector('[data-section=color]'); return !!e && e.offsetParent !== null; })()",
        "(() => { const e = document.querySelector('[data-section=display]'); return !!e && e.offsetParent !== null; })()",
        "!(() => { const e = document.querySelector('[data-section=data]'); return !!e && e.offsetParent !== null; })()",
        "document.querySelector('#tab-explore').getAttribute('aria-selected') === 'true'"
      ],
      "screenshot": "ui-explore.png"
    },
    {
      "name": "keyboard: ArrowLeft goes back to Map",
      "eval": "document.querySelector('#tab-explore').focus(); document.querySelector('#tab-explore').dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowLeft', bubbles: true }))",
      "until": "a.ui.tab === 'map'",
      "assert": [
        "document.activeElement && document.activeElement.id === 'tab-map'"
      ]
    },
    {
      "name": "collapse a section",
      "click": "[data-section=umap] > summary",
      "until": "a.ui.closed.includes('umap')",
      "assert": [
        "!document.querySelector('[data-section=umap]').open"
      ]
    },
    {
      "name": "state persists",
      "until": "h.state && h.state.ui && h.state.ui.closed.includes('umap') && h.state.ui.tab === 'map'"
    },
    {
      "name": "reopen section",
      "click": "[data-section=umap] > summary",
      "until": "!a.ui.closed.includes('umap')"
    },
    {
      "name": "fit to view from toolbar",
      "eval": "a.renderer.viewState.zoom -= 2; a.fitView()",
      "assert": [
        "document.querySelectorAll('.plot-toolbar .tool').length === 3"
      ]
    },
    {
      "name": "export tab",
      "until": "a.ui.tab === 'export'",
      "click": "#tab-export",
      "assert": [
        "(() => { const e = document.querySelector('[data-section=export-image]'); return !!e && e.offsetParent !== null; })()",
        "(() => { const e = document.querySelector('[data-section=export-frame]'); return !!e && e.offsetParent !== null; })()",
        "(() => { const e = document.querySelector('[data-section=export-code]'); return !!e && e.offsetParent !== null; })()",
        "!(() => { const e = document.querySelector('[data-section=result]'); return !!e && e.offsetParent !== null; })()",
        "!document.querySelector('.plot-toolbar [aria-label=\"Export PNG\"]')"
      ],
      "screenshot": "ui-export.png"
    },
    {
      "name": "export png",
      "eval": "[...document.querySelectorAll('[data-section=export-image] button')].find(b => b.textContent.includes('Export PNG')).click()",
      "until": "h.png.startsWith('data:image/png')"
    },
    {
      "name": "add coordinates",
      "eval": "[...document.querySelectorAll('[data-section=export-frame] button')].find(b => b.textContent.includes('Add coordinates')).click()",
      "until": "a.toast && a.toast.includes('umap_x')"
    },
    {
      "name": "new DataFrame needs a selection",
      "assert": [
        "[...document.querySelectorAll('[data-section=export-frame] button')].find(b => b.textContent.includes('New DataFrame')).disabled"
      ]
    },
    {
      "name": "new DataFrame from the selection",
      "eval": "const m = new Uint8Array(a.nKept); m.fill(1, 0, 10); a.setSelection(m); await new Promise(r => setTimeout(r, 100)); [...document.querySelectorAll('[data-section=export-frame] button')].find(b => b.textContent.includes('New DataFrame')).click()",
      "until": "h.log.some(l => l.includes('Created df_selection with 10 selected rows'))",
      "assert": [
        "[...document.querySelectorAll('[data-section=export-frame] button')].find(b => b.textContent.includes('New DataFrame')).textContent.includes('10 selected rows')"
      ]
    },
    {
      "name": "copy as Python",
      "eval": "a.clearSelection(); [...document.querySelectorAll('[data-section=export-code] button')].find(b => b.textContent.includes('umap-learn')).click()",
      "until": "h.clipboard.includes('umap.UMAP(')"
    },
    {
      "name": "copy as DataMapPlot code",
      "eval": "[...document.querySelectorAll('[data-section=export-code] button')].find(b => b.textContent.includes('DataMapPlot')).click()",
      "until": "h.clipboard.includes('datamapplot.create_interactive_plot')"
    },
    {
      "name": "restore ui from saved state",
      "eval": "a['onInit'](a.describe, a.settings, a.variable, { ...h.state, ui: { tab: 'explore', closed: ['display', 42] } })",
      "until": "a.ui.tab === 'explore'",
      "assert": [
        "a.ui.closed.length === 1 && a.ui.closed[0] === 'display'",
        "!document.querySelector('[data-section=display]').open"
      ],
      "timeout": 60000
    }
  ]
}
