{
  "variable": "df",
  "description": "C3 — Python API: apiCommand dispatch, selectionChanged, savePng via harness comm",
  "settings": { "maxAnchors": 500, "maxAnchorsCpu": 500 },
  "setup": "import pandas as pd; import numpy as np; df = pd.DataFrame({'x': np.random.rand(50), 'cat': (np.arange(50) % 3).astype(str)})",
  "steps": [
    {
      "description": "wait for atlas to be ready (phase === 'ready')",
      "until": "a.phase === 'ready'",
      "timeout": 15000,
      "assert": "a.phase === 'ready'"
    },
    {
      "description": "dispatch colorBy(0) via comm and verify colorMeta is set",
      "eval": "window.__harness.dispatchCommCommand('cmd-color-1', 'colorBy', {column: 0})",
      "until": "a.colorMeta !== null",
      "timeout": 5000,
      "assert": "a.colorMeta !== null"
    },
    {
      "description": "dispatch labelBy(1) via comm — does not error",
      "eval": "window.__harness.dispatchCommCommand('cmd-label-1', 'labelBy', {column: 1})",
      "until": "a.labelMeta !== null",
      "timeout": 5000,
      "assert": "a.labelMeta !== null"
    },
    {
      "description": "invert selection — selectionChanged is captured by host",
      "eval": "a.invertSelection()",
      "until": "window.__harness.lastSelectionChanged !== null",
      "timeout": 3000,
      "assert": "window.__harness.lastSelectionChanged !== null && window.__harness.lastSelectionChanged.nKept > 0"
    },
    {
      "description": "clear selection — lastSelectionChanged mask is null",
      "eval": "a.clearSelection()",
      "until": "window.__harness.lastSelectionChanged && window.__harness.lastSelectionChanged.mask === null",
      "timeout": 3000,
      "assert": "window.__harness.lastSelectionChanged.mask === null"
    }
  ]
}
