{
  "variable": "bench",
  "setup": "import numpy as np, polars as pl\nrng = np.random.default_rng(2)\nn, d = 200_000, 50\nk = rng.integers(0, 10, n)\nX = (rng.normal(0, 5, (10, d))[k] + rng.normal(0, 1, (n, d))).astype('float32')\nbench = pl.from_numpy(X, schema=[f'f{i}' for i in range(d)]).with_columns(pl.Series('label', [f'l{v}' for v in k]))\ndel X\n",
  "steps": [
    {
      "name": "10k anchors GPU",
      "eval": "a.prepare.maxAnchors = 10000; a.useGpu = true; a.timings = {}; a.runPrepare()",
      "until": "a.phase === 'ready' && a.timings.umap && a.prepared.nAnchors === 10000",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "10k anchors CPU",
      "eval": "a.useGpu = false; a.timings = {}; a.startUmap()",
      "until": "a.phase === 'ready' && a.timings.umap",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "25k anchors GPU",
      "eval": "a.prepare.maxAnchors = 25000; a.useGpu = true; a.timings = {}; a.runPrepare()",
      "until": "a.phase === 'ready' && a.timings.umap && a.prepared.nAnchors === 25000",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "25k anchors CPU",
      "eval": "a.useGpu = false; a.timings = {}; a.startUmap()",
      "until": "a.phase === 'ready' && a.timings.umap",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "50k anchors GPU",
      "eval": "a.prepare.maxAnchors = 50000; a.useGpu = true; a.timings = {}; a.runPrepare()",
      "until": "a.phase === 'ready' && a.timings.umap && a.prepared.nAnchors === 50000",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "50k anchors CPU",
      "eval": "a.useGpu = false; a.timings = {}; a.startUmap()",
      "until": "a.phase === 'ready' && a.timings.umap",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "100k anchors GPU",
      "eval": "a.prepare.maxAnchors = 100000; a.useGpu = true; a.timings = {}; a.runPrepare()",
      "until": "a.phase === 'ready' && a.timings.umap && a.prepared.nAnchors === 100000",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "100k anchors CPU",
      "eval": "a.useGpu = false; a.timings = {}; a.startUmap()",
      "until": "a.phase === 'ready' && a.timings.umap",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "200k anchors GPU",
      "eval": "a.prepare.maxAnchors = 200000; a.useGpu = true; a.timings = {}; a.runPrepare()",
      "until": "a.phase === 'ready' && a.timings.umap && a.prepared.nAnchors === 200000",
      "timeout": 600000,
      "report": "{ umap: a.timings.umap, gpu: a.useGpu }"
    },
    {
      "name": "200k anchors d10 PCA GPU",
