{
  "name": "positron-atlas",
  "displayName": "Positron Atlas",
  "description": "Interactive UMAP scatter plots of high-dimensional DataFrames in Positron.",
  "version": "0.1.0",
  "publisher": "jeroenjanssens",
  "license": "MIT",
  "author": {
    "name": "Jeroen Janssens"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "positron",
    "umap",
    "embedding",
    "dataframe",
    "pandas",
    "polars"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:positronAtlas.view"
  ],
  "contributes": {
    "commands": [
      {
        "command": "positronAtlas.openFromDataExplorer",
        "title": "Open in Atlas (UMAP)",
        "category": "Atlas",
        "icon": "$(graph-scatter)",
        "enablement": "isPositron"
      },
      {
        "command": "positronAtlas.openDataFrame",
        "title": "Open DataFrame\u2026",
        "category": "Atlas",
        "enablement": "isPositron"
      }
    ],
    "menus": {
      "editor/actions/right": [
        {
          "command": "positronAtlas.openFromDataExplorer",
          "when": "isPositron && activeEditor == 'workbench.editor.positronDataExplorer'"
        }
      ],
      "editor/title": [
        {
          "command": "positronAtlas.openFromDataExplorer",
          "when": "isPositron && activeEditor == 'workbench.editor.positronDataExplorer'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "positronAtlas.openFromDataExplorer",
          "when": "isPositron && activeEditor == 'workbench.editor.positronDataExplorer'"
        }
      ]
    },
    "configuration": {
      "title": "Positron Atlas",
      "properties": {
        "positronAtlas.maxAnchors": {
          "type": "number",
          "default": 100000,
          "description": "Maximum number of rows UMAP runs on in the browser when WebGPU is available. Remaining rows are placed by nearest-anchor projection in the kernel."
        },
        "positronAtlas.maxAnchorsCpu": {
          "type": "number",
          "default": 25000,
          "description": "Maximum number of anchor rows when UMAP runs on the CPU (no WebGPU). CPU UMAP takes about 0.7 ms per row for 200 epochs."
        },
        "positronAtlas.useWebGpu": {
          "type": "boolean",
          "default": true,
          "description": "Run UMAP on the GPU (WebGPU) when available; falls back to the CPU automatically."
        },
        "positronAtlas.anchorBudget": {
          "type": "number",
          "default": 10000000,
          "description": "Maximum number of values (anchors \u00d7 dimensions) sent to the browser UMAP."
        },
        "positronAtlas.defaultSamplePct": {
          "type": "number",
          "default": 100,
          "minimum": 0.1,
          "maximum": 100,
          "description": "Default percentage of rows to sample."
        },
        "positronAtlas.pcaEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Apply PCA before UMAP by default."
        },
        "positronAtlas.pcaDims": {
          "type": "number",
          "default": 50,
          "description": "Default number of PCA dimensions."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node scripts/build-ext.mjs",
    "build:webview": "vite build --config vite.config.mts",
    "watch:ext": "node scripts/build-ext.mjs --watch",
    "watch:webview": "vite build --config vite.config.mts --watch",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.webview.json",
    "test": "vitest run",
    "test:py": "uv run --project python pytest python/tests -q",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "test:e2e": "node test/e2e/run.mjs test/e2e/scenario-small.json && node test/e2e/run.mjs test/e2e/scenario-explorer.json && node test/e2e/run.mjs test/e2e/scenario-polars-projection.json && node test/e2e/restore.mjs"
  },
  "devDependencies": {
    "@posit-dev/positron": "^0.2.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "embedding-atlas": "^0.26.0"
  }
}
